// IronPulse - Relational Schema (Phase 2)
Project IronPulse {
  database_type: "SQL Server"
}

Table person {
  Note: 'Lop cha; mot nguoi co the thuoc nhieu vai tro (overlapping). Dieu kien total can kiem tra rieng.'
  person_id int [pk, not null]
  ssn varchar(12) [not null, unique]
  full_name nvarchar(120) [not null]
  email varchar(150) [not null, unique]
  phone varchar(15) [not null, unique]
  date_of_birth date [not null]
  gender nvarchar(15) [not null]
  address nvarchar(255)
  created_at datetime2 [not null, note: 'gan tu dong khi tao, theo Phase 1']
  password_hash varchar(255) [not null]
}

Table member {
  person_id int [pk, not null]
  emergency_contact_phone varchar(15) [not null]
  join_date date [not null]
  health_notes nvarchar(500)
}

Table trainer {
  person_id int [pk, not null]
  hire_date date [not null]
  employment_status varchar(20) [not null]
}

Table trainer_certification {
  Note: 'Tach tu trainer.certification da tri trong Phase 1. Mot dong = mot chung chi cua mot trainer.'
  person_id int [not null]
  certification nvarchar(100) [not null]

  indexes {
    (person_id, certification) [pk]
  }
}

Table staff {
  person_id int [pk, not null]
  position nvarchar(60) [not null]
  hire_date date [not null]
  employment_status varchar(20) [not null]
}

Table membership_plan {
  plan_id int [pk, not null]
  plan_name nvarchar(100) [not null, unique]
  duration_months int [not null]
  base_price decimal(18,2) [not null]
  description nvarchar(500)
}

Table membership {
  membership_id int [pk, not null]
  person_id int [not null]
  plan_id int [not null]
  start_date date
  end_date date
  status varchar(25) [not null]
  total_price decimal(18,2) [note: 'gia da mua theo BR-17; NULL khi chua thanh toan']
  created_at datetime2 [not null]
}

Table service_type {
  service_type_id int [pk, not null]
  service_name nvarchar(100) [not null, unique]
  description nvarchar(500)
}

Table plan_inclusion {
  Note: 'Khoa chinh ghep (plan_id, service_type_id); -1 quota_per_cycle la khong gioi han.'
  plan_id int [not null]
  service_type_id int [not null]
  quota_per_cycle int [not null, note: '-1 = khong gioi han; khac -1 phai >= 0']

  indexes {
    (plan_id, service_type_id) [pk]
  }
}

Table member_service_usage {
  usage_id int [pk, not null]
  membership_id int [not null]
  service_type_id int [not null]
  session_id int
  used_at datetime2 [not null]
  usage_status varchar(20) [not null]
}

Table room {
  room_id int [pk, not null]
  room_name nvarchar(100) [not null, unique]
  room_type varchar(30) [not null]
  status varchar(25) [not null]
}

Table session {
  Note: 'Lop cha cua pt_session va group_class_session; yeu cau total + disjoint can kiem tra rieng.'
  session_id int [pk, not null]
  trainer_id int [not null]
  room_id int [not null]
  start_time datetime2 [not null]
  end_time datetime2 [not null]
  session_type varchar(20) [not null]
  created_at datetime2 [not null]
}

Table pt_session {
  session_id int [pk, not null]
  person_id int [not null]
  training_focus nvarchar(255) [not null]
}

Table group_class_session {
  Note: 'current_enrollment la thuoc tinh dan xuat: dem booking_status = SUCCESS theo session_id; khong luu cot vat ly.'
  session_id int [pk, not null]
  class_name nvarchar(100) [not null]
  category nvarchar(60) [not null]
  max_capacity int [not null]
}

Table booking {
  Note: 'BR-19: moi person_id + session_id chi co toi da mot booking SUCCESS; CANCEL co the dat lai. Can filtered unique index o Phase 3.'
  booking_id int [pk, not null]
  person_id int [not null]
  session_id int [not null]
  booked_at datetime2 [not null]
  booking_status varchar(20) [not null, note: 'SUCCESS hoac CANCEL; BR-19 loc SUCCESS']
  cancelled_at datetime2
}

Table equipment {
  equipment_id int [pk, not null]
  equipment_name nvarchar(120) [not null]
  serial_number varchar(100) [not null, unique]
  room_id int
  status varchar(25) [not null]
}

Table payment {
  Note: 'Moi membership toi da mot payment theo UNIQUE membership_id trong Phase 1.'
  payment_id int [pk, not null]
  membership_id int [not null, unique]
  amount decimal(18,2) [not null]
  payment_time datetime2 [not null]
  payment_method varchar(25) [not null]
}

Table equipment_maintenance_log {
  maintenance_id int [pk, not null]
  equipment_id int [not null]
  start_date date [not null]
  cost decimal(18,2)
  end_date date
  description nvarchar(500)
}

// Foreign keys: dau > = nhieu-toi-mot; dau - = mot-toi-mot.
Ref: member.person_id - person.person_id
Ref: trainer.person_id - person.person_id
Ref: trainer_certification.person_id > trainer.person_id
Ref: staff.person_id - person.person_id
Ref: membership.person_id > member.person_id
Ref: membership.plan_id > membership_plan.plan_id
Ref: plan_inclusion.plan_id > membership_plan.plan_id
Ref: plan_inclusion.service_type_id > service_type.service_type_id
Ref: member_service_usage.membership_id > membership.membership_id
Ref: member_service_usage.service_type_id > service_type.service_type_id
Ref: member_service_usage.session_id > session.session_id
Ref: session.trainer_id > trainer.person_id
Ref: session.room_id > room.room_id
Ref: pt_session.session_id - session.session_id
Ref: pt_session.person_id > member.person_id
Ref: group_class_session.session_id - session.session_id
Ref: booking.person_id > member.person_id
Ref: booking.session_id > group_class_session.session_id
Ref: equipment.room_id > room.room_id
Ref: payment.membership_id - membership.membership_id
Ref: equipment_maintenance_log.equipment_id > equipment.equipment_id

// BR-19 KHONG dat UNIQUE vo dieu kien tren booking(person_id, session_id).
// Trong SQL Server can filtered UNIQUE INDEX WHERE booking_status = SUCCESS.
