  <diagram name="Sơ đồ UML - Phase 1" id="f02er">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1890" pageHeight="1410" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Cấu hình đường nối vuông góc và ẩn icon tròn mặc định để giống ảnh gốc\nskinparam linetype ortho\nhide circle\nskinparam classAttributeIconSize 0\n\n&#39; === CÁC BẢNG ĐỘC LẬP PHÍA TRÊN ===\nclass Payment {\n  +payment_id : INT\n  +membership_id : INT\n  +amount : DECIMAL\n  +payment_date : TIMESTAMP\n  +payment_method : ENUM\n  +payment_status : ENUM\n  +transaction_ref : VARCHAR\n  +processed_by_staff_id : INT\n}\n\nclass Booking {\n  +booking_id : INT\n  +member_id : INT\n  +session_id : INT\n  +booked_at : TIMESTAMP\n  +booking_status : ENUM\n  +attended_at : DATETIME\n}\n\nclass Member_Service_Usage {\n  +usage_id : INT\n  +used_at : TIMESTAMP\n  +member_id : INT UNSIGNED\n  +service_type_id : INT\n  +session_id : INT UNSIGNED\n  +quantity : SMALLINT\n  +recorded_by_staff_id : INT UNSIGNED\n}\n\nclass Plan_Service {\n  +plan_id : INT UNSIGNED\n  +service_type_id : INT\n  +quota_per_cycle : SMALLINT\n}\n\nclass Equipment {\n  +equipment_id : INT\n  +equipment_name : VARCHAR\n  +model : VARCHAR\n  +serial_number : VARCHAR\n  +manufacturer : VARCHAR\n  +purchase_date : DATE\n  +warranty_expiry_date : DATE\n  +room_id : INT\n  +status : ENUM\n  +last_maintenance_date : DATE\n}\n\nclass Equipment_Maintenance_Log {\n  +equipment_id : INT\n  +log_seq : SMALLINT\n  +maintenance_type : ENUM\n  +description : TEXT\n  +old_status : ENUM\n  +new_status : ENUM\n  +reported_by_staff_id : INT\n  +reported_at : TIMESTAMP\n  +resolved_at : TIMESTAMP\n  +cost : DECIMAL\n  +downtime_hours : DECIMAL\n}\n\n&#39; === NHÁNH PERSON &amp; KẾ THỪA ===\nclass Person {\n  +person_id : INT\n  +full_name : VARCHAR\n  +email : VARCHAR\n  +phone : VARCHAR\n  +date_of_birth : DATE\n  +gender : ENUM\n  +address_street : VARCHAR\n  +address_district : VARCHAR\n  +address_city : VARCHAR\n  +password_hash : VARCHAR\n  +created_at : TIMESTAMP\n  +is_deleted : TINYINT\n}\n\nclass Staff {\n  +person_id : INT\n  +position : ENUM\n  +department : ENUM\n  +hire_date : DATE\n  +employment_status : ENUM\n}\n\nclass Trainer {\n  +person_id : INT\n  +specialization : VARCHAR\n  +hire_date : DATE\n  +hourly_rate : DECIMAL\n  +employment_status : ENUM\n  +bio : TEXT\n}\n\nclass Member {\n  +person_id : INT\n  +emergency_contact_name : VARCHAR\n  +emergency_contact_phone : VARCHAR\n  +join_date : DATE\n  +health_notes : TEXT\n}\n\n&#39; === NHÁNH ROOM &amp; SESSION ===\nclass Room {\n  +room_id : INT\n  +room_name : VARCHAR\n  +room_type : ENUM\n  +capacity : SMALLINT\n  +floor : TINYINT\n  +status : ENUM\n}\n\nclass Session {\n  +session_id : INT\n  +trainer_id : INT\n  +room_id : INT\n  +start_time : DATETIME\n  +end_time : DATETIME\n  +session_type : ENUM\n  +status : ENUM\n  +created_at : TIMESTAMP\n  +notes : VARCHAR\n}\n\nclass PT_Session {\n  +session_id : INT\n  +member_id : INT\n  +training_focus : ENUM\n  +member_feedback : TEXT\n  +trainer_notes : TEXT\n}\n\nclass Group_Class_Session {\n  +session_id : INT\n  +class_name : VARCHAR\n  +category : ENUM\n  +max_capacity : SMALLINT\n  +current_enrollment : INT\n  +is_recurring : TINYINT\n  +recurrence_pattern : VARCHAR\n}\n\n&#39; === NHÁNH MEMBERSHIP &amp; SERVICE ===\nclass Membership_Plan {\n  +plan_id : INT\n  +plan_name : VARCHAR\n  +duration_months : TINYINT\n  +base_price : DECIMAL\n  +description : TEXT\n  +is_active : TINYINT\n}\n\nclass Service_Type {\n  +service_type_id : INT\n  +service_name : VARCHAR\n  +description : VARCHAR\n  +unit_label : VARCHAR\n}\n\nclass Membership {\n  +membership_id : INT UNSIGNED\n  +member_id : INT UNSIGNED\n  +plan_id : INT UNSIGNED\n  +start_date : DATE\n  +end_date : DATE\n  +status : ENUM\n  +amount_paid : DECIMAL\n  +freeze_count : TINYINT\n  +total_frozen_days : SMALLINT\n  +created_at : TIMESTAMP\n  +notes : VARCHAR\n}\n\nclass Membership_Freeze_Log {\n  +membership_id : INT UNSIGNED\n  +freeze_seq : TINYINT\n  +freeze_start_date : DATE\n  +freeze_end_date : DATE\n  +reason : VARCHAR\n  +requested_by_member_id : INT UNSIGNED\n  +approved_by_staff_id : INT UNSIGNED\n}\n\n&#39; === CÁC MỐI QUAN HỆ TRONG ẢNH ===\n&#39; Kế thừa từ Person\nPerson &lt;|-- Staff\nPerson &lt;|-- Trainer\nPerson &lt;|-- Member\n\n&#39; Quan hệ của Trainer, Room và Session\nTrainer \&quot;1..1\&quot; -- \&quot;0..*\&quot; Session : CONDUCTS\nRoom \&quot;1..1\&quot; -right- \&quot;0..*\&quot; Session : HOSTS\n\n&#39; Kế thừa từ Session\nSession &lt;|-- PT_Session\nSession &lt;|-- Group_Class_Session\n\n&#39; Quan hệ nhánh Membership\nMember \&quot;1..1\&quot; -- \&quot;1..*\&quot; Membership : REGISTERS\nMembership_Plan \&quot;1..1\&quot; -right- \&quot;0..*\&quot; Membership : BASED_ON\nMembership_Plan \&quot;0..*\&quot; -- \&quot;0..*\&quot; Service_Type : INCLUDES\nMembership \&quot;0..*\&quot; -- \&quot;0..*\&quot; Service_Type : CONSUMES\n\n&#39; Quan hệ Hợp thành (Hình thoi đen đặc)\nMembership \&quot;1..1\&quot; *-right- \&quot;0..*\&quot; Membership_Freeze_Log : HAS_FREEZE\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HVl_KQ-kCMY72vYe2atb-268">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
